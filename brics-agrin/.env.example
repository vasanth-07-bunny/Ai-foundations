# ============================================================
# BRICS AgriN — Environment Variable Reference
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# NEVER use production secrets in development or test environments.
# ============================================================

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────
# PostgreSQL 15+ with PostGIS extension
DATABASE_URL=postgresql://agrin_user:CHANGE_ME@localhost:5432/agrin_dev

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Secrets ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters. Use different values per environment.
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars_random_value
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_different_random_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS_RAW=http://localhost:5173

# ── Object Storage (S3-compatible) ───────────────────────────
# Used for diagnostic image uploads — images never stored on filesystem
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=agrin-uploads
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME

# ── AI / Advisory ────────────────────────────────────────────
# Optional: only required if using OpenAI for advisory explanations
OPENAI_API_KEY=
ADVISORY_MODEL_VERSION=1.0.0
DIAGNOSTIC_MODEL_VERSION=1.0.0

# ── Weather Provider ─────────────────────────────────────────
# Open-Meteo is used by default (no API key required for basic use)
OPENMETEO_BASE_URL=https://api.open-meteo.com

# ── Satellite Provider ───────────────────────────────────────
# Optional: fill in when a real satellite data provider is integrated
SATELLITE_API_KEY=
SATELLITE_BASE_URL=

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ── Image Constraints ────────────────────────────────────────
IMAGE_MAX_SIZE_BYTES=10485760
IMAGE_MAX_DIMENSION_PX=4096
IMAGE_ALLOWED_MIME_TYPES_RAW=image/jpeg,image/png,image/webp

# ── Cache TTLs ───────────────────────────────────────────────
ADVISORY_CACHE_TTL_SECONDS=3600
WEATHER_CACHE_TTL_SECONDS=1800
SATELLITE_CACHE_TTL_SECONDS=7200

# ── External HTTP ────────────────────────────────────────────
EXTERNAL_HTTP_TIMEOUT_MS=8000
EXTERNAL_HTTP_RETRIES=3
