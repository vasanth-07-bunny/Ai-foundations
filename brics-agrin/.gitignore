# ── Secrets — NEVER commit ────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx

# ── Node ──────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Log files — may contain sensitive request/response data ───
*.log
**/*.log
pino-*.log

# ── Build outputs ─────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Test outputs ──────────────────────────────────────────────
coverage/
.nyc_output/

# ── Prisma ────────────────────────────────────────────────────
# Generated client is built from schema — not committed
packages/api/node_modules/.prisma/

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Uploads (local dev only) ──────────────────────────────────
uploads/
tmp/
