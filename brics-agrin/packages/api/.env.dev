NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://agrin:agrin@localhost:5432/agrin_dev
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=local-dev-access-secret-min-32-characters-ok
JWT_REFRESH_SECRET=local-dev-refresh-secret-min-32-characters-ok
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
CORS_ORIGINS_RAW=http://localhost:5173
OBJECT_STORAGE_BUCKET=agrin-dev
OBJECT_STORAGE_REGION=us-east-1
OPENMETEO_BASE_URL=https://api.open-meteo.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
IMAGE_MAX_SIZE_BYTES=10485760
IMAGE_MAX_DIMENSION_PX=4096
IMAGE_ALLOWED_MIME_TYPES_RAW=image/jpeg,image/png,image/webp
ADVISORY_CACHE_TTL_SECONDS=3600
WEATHER_CACHE_TTL_SECONDS=1800
SATELLITE_CACHE_TTL_SECONDS=7200
EXTERNAL_HTTP_TIMEOUT_MS=8000
EXTERNAL_HTTP_RETRIES=3
ADVISORY_MODEL_VERSION=1.0.0
DIAGNOSTIC_MODEL_VERSION=1.0.0
